RewriteEngine On
RewriteBase /

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/avif "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
<FilesMatch "\.(?:css|js|mjs|png|jpe?g|webp|avif|woff2?)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>

# Use one secure canonical website host without redirecting api.opticgallery.am.
RewriteCond %{HTTP_HOST} ^www\.opticgallery\.am$ [NC,OR]
RewriteCond %{HTTP_HOST} ^opticgallery\.am$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.opticgallery\.am$ [NC]
RewriteRule ^ https://opticgallery.am%{REQUEST_URI} [R=301,L,NE]

RewriteRule ^index\.html$ - [L]
RewriteRule ^(?:api|uploads)(/|$) - [L]

# Armenian is the default locale and has one clean canonical URL.
RewriteCond %{QUERY_STRING} ^lang=hy$ [NC]
RewriteRule ^ https://opticgallery.am%{REQUEST_URI} [R=301,L,NE,QSD]

# The document root is a real directory, so route it before the file/directory bypass.
RewriteCond %{QUERY_STRING} (^|&)lang=(en|ru|hy)(&|$) [NC]
RewriteRule ^$ /seo/%2/home/index.html [L]
RewriteRule ^$ /seo/hy/home/index.html [L]

# Blog assets share the /blog directory, so route the page before the directory bypass.
RewriteCond %{QUERY_STRING} (^|&)lang=(en|ru|hy)(&|$) [NC]
RewriteRule ^blog/?$ /seo/%2/blog/index.html [L]
RewriteRule ^blog/?$ /seo/hy/blog/index.html [L]
RewriteCond %{QUERY_STRING} (^|&)lang=(en|ru|hy)(&|$) [NC]
RewriteRule ^blog/([^/]+)/?$ /seo/%2/blog/$1/index.html [L]
RewriteRule ^blog/([^/]+)/?$ /seo/hy/blog/$1/index.html [L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Serve generated metadata for public routes while preserving the requested URL.
# Faceted/search catalog URLs are crawlable for discovery but are not indexable.
RewriteCond %{QUERY_STRING} (^|&)(search|category|brand|gender|stock|discounted|banner)=[^&]* [NC]
RewriteCond %{QUERY_STRING} (^|&)lang=(en|ru|hy)(&|$) [NC]
RewriteRule ^products/?$ /seo/%2/products-filter/index.html [L]
RewriteCond %{QUERY_STRING} (^|&)(search|category|brand|gender|stock|discounted|banner)=[^&]* [NC]
RewriteRule ^products/?$ /seo/hy/products-filter/index.html [L]

RewriteCond %{QUERY_STRING} (^|&)lang=(en|ru|hy)(&|$) [NC]
RewriteRule ^(products(?:/[0-9]+)?|brands|about|contact|repair-service)/?$ /seo/%2/$1/index.html [L]
RewriteRule ^(products(?:/[0-9]+)?|brands|about|contact|repair-service)/?$ /seo/hy/$1/index.html [L]

# Private application routes are available but never indexable.
RewriteRule ^(admin(?:/login)?|cart|cart-preview|checkout|order-success)/?$ /seo/noindex/index.html [L]

# Unknown direct requests return a real HTTP 404 page.
ErrorDocument 404 /404.html
RewriteRule ^ - [R=404,L]
